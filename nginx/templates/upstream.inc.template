# How every request reaches Earth Search. Included by both locations in default.conf.

proxy_pass ${UPSTREAM_URL};
proxy_http_version 1.1;
proxy_ssl_server_name on;

# Earth Search sends its own Access-Control-Allow-Origin, and the ingress adds one too.
proxy_hide_header Access-Control-Allow-Origin;

# Earth Search is a public API. Do not send it platform credentials.
proxy_set_header Authorization "";
proxy_set_header Cookie "";

proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# Uncompressed responses, so sub_filter and njs can rewrite them.
proxy_set_header Accept-Encoding "";

proxy_read_timeout 60s;
proxy_connect_timeout 10s;
proxy_send_timeout 60s;
